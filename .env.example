# Agentix Enterprise Environment Configuration

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agentix

# Redis Cache & Session
REDIS_URL=redis://localhost:6379/0

# Security & Cryptographic Tokens
JWT_SECRET=generate-a-secure-random-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_SECRET=generate-a-secure-random-32-character-secret-for-nextauth
ENCRYPTION_KEY=generate-a-secure-32-byte-hex-or-passphrase-for-aes-gcm-2fa-storage

# Google OAuth 2.0 & OpenID Connect
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AI Models & Providers
OPENAI_API_KEY=sk-your-openai-api-key
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
OLLAMA_HOST=http://localhost:11434

# App Runtime
ENVIRONMENT=development # production, development
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE_MB=50

# Frontend & Backend Network Boundaries
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
